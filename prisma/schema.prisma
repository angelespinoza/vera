// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Etapa 1 — Empresa, treasury y empleados (ver docs/ALCANCE_FUNCIONAL_ETAPAS.md, Módulos 1 y 2)

model Company {
  id        String   @id @default(cuid())
  name      String
  cfoEmail  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Treasury wallet en Stellar testnet (custodial). La secret key se guarda cifrada.
  treasuryPublicKey          String @unique
  treasurySecretKeyEncrypted String

  // Vault on-chain (Soroban) — techo de gasto forzado por contrato, ver
  // contracts/spending-vault. El operador es una llave separada del
  // treasury: solo puede pagar a empleados registrados, hasta su límite.
  vaultContractId              String?
  vaultOperatorPublicKey       String?
  vaultOperatorSecretEncrypted String?
  vaultInitialized             Boolean @default(false)

  employees Employee[]
  policy    Policy?
  expenses  Expense[]
}

model Employee {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String
  email     String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Wallet en Stellar testnet (custodial). La secret key se guarda cifrada.
  walletPublicKey          String @unique
  walletSecretKeyEncrypted String

  // Alta en el vault on-chain (contracts/spending-vault) — espejo de lo que
  // el contrato realmente tiene registrado, para no tener que leerlo on-chain
  // en cada render. vaultLimit es el tope de por vida en USDC (7 decimales
  // en el contrato; aquí en unidades de USDC normales).
  vaultRegistered Boolean @default(false)
  vaultLimit      Float?

  expenses Expense[]

  @@unique([companyId, email])
}

// Etapa 2 — Política (ver docs/ALCANCE_FUNCIONAL_ETAPAS.md, Módulo 3)

model Policy {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Texto original en lenguaje natural, tal como lo escribió el CFO.
  rawText String

  // Estructura JSON producida por el policy compiler (o editada manualmente
  // por el CFO). Ver src/lib/policy/types.ts para la forma exacta.
  structured Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Etapa 3 — Envío de gasto + evidencia (ver docs/ALCANCE_FUNCIONAL_ETAPAS.md, Módulo 4)

model Expense {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Ambos null para gastos creados por carga masiva de Excel (sin foto real,
  // ver src/app/actions/bulk.ts) — todo lo demás del pipeline es idéntico.
  receiptFile     Bytes?
  receiptMimeType String?
  // SHA-256 del archivo, para detectar comprobantes duplicados (Etapa 4).
  // Null para filas de Excel: no hay imagen que hashear.
  receiptHash     String?

  // true si el gasto se creó por carga masiva de Excel en vez del flujo
  // normal de foto + confirmación del empleado.
  bulkImported Boolean @default(false)

  // Salida cruda de la extracción con visión (ver src/lib/receipt/types.ts).
  extractedData Json?

  // Datos confirmados/corregidos por el empleado — inicialmente prellenados
  // con lo extraído, editables antes de confirmar.
  amount        Float?
  currency      String?
  merchant      String?
  expenseDate   DateTime?
  category      String?
  justification String?

  // EXTRACTED: recién subido, esperando confirmación del empleado.
  // SUBMITTED: confirmado, reglas+Jev evaluándose (transitorio).
  // APPROVED / REJECTED / REVIEW_REQUIRED: decisión final del motor (Etapa 6).
  status String @default("EXTRACTED")

  // Resultado del motor de reglas determinísticas (Etapa 4 / Módulo 5).
  // Ver src/lib/rules/types.ts para la forma exacta.
  ruleResults Json?

  // Resultado de la evaluación semántica con Jev/TypeSafe (Etapa 5 / Módulo 6).
  // Ver src/lib/jev/types.ts para la forma exacta.
  jevResults Json?

  // Snapshot de la política estructurada tal como estaba al momento de decidir
  // (auditabilidad: la política puede cambiar después). Etapa 6 / Módulo 7.
  policySnapshot Json?
  // Resultado del motor de decisión (confidence gate). Ver src/lib/decision/types.ts.
  decision       Json?

  // Vía comparativa con LLM genérico (Etapa 7 / Módulo 10) — puramente
  // informativa, nunca influye en `decision`. Ver src/lib/shadow/types.ts.
  shadowResults Json?

  // Pago en Stellar (Etapa 8 / Módulo 8) — solo se intenta si decision.outcome
  // es APPROVED. paymentTxHash presente = pago exitoso; paymentError presente
  // = se intentó y falló (el gasto queda aprobado pero no pagado).
  paymentTxHash String?
  paymentError  String?
  paidAt        DateTime?
  // true si este pago salió por el vault on-chain (release_payment) en vez
  // del pago clásico Stellar firmado con la llave completa del treasury.
  paidViaVault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
